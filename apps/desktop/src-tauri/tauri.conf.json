{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaperWeave",
  "version": "0.1.1",
  "identifier": "org.paperweave.app",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/paperweave-backend"
    ],
    "resources": {
      "resources/migrations": "migrations/",
      "resources/backend": "backend/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}